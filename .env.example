PORT=3000
# En production, DATABASE_URL DOIT activer TLS en transit via le paramètre sslmode :
#   sslmode=require  -> chiffrement TLS sans vérification du certificat
#   sslmode=verify-full -> TLS + vérification du certificat CA (recommandé en production)
# Exemple : DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=verify-full"
DATABASE_URL="postgresql://postgres:password@localhost:5432/connecteo_db1"

# Secrets JWT signés en HS256. Le secret DOIT contenir au moins 32 caractères
# cryptographiques (>= 256 bits) : le serveur refuse de démarrer sinon.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-secret-key-in-production"
JWT_ACCESS_EXPIRES_IN="5m"
JWT_REFRESH_EXPIRES_IN="7d"

# En production, le cookie de refresh token est marqué "Secure" (HTTPS uniquement).
# NODE_ENV=production
FRONTEND_URL="http://localhost:3001"

# Liste blanche des domaines autorisés pour les redirections (séparés par des virgules)
# Exemple : ALLOWED_REDIRECT_DOMAINS="connecteo.mg,www.connecteo.mg,localhost:3001"
ALLOWED_REDIRECT_DOMAINS=""

# Rétention de la piste d'audit en jours. Les journaux plus vieux que cette durée
# sont purgés quotidiennement (première purge 1 min après le démarrage du serveur).
# Valeur par défaut : 7
AUDIT_RETENTION_DAYS="7"

# Clé de chiffrement champ-par-champ (AES-256-GCM) des données PII (téléphones, emails, noms).
# DOIT faire exactement 32 octets encodés en 64 caractères hexadécimaux (le serveur refuse de démarrer sinon).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Stockage S3 / Cloudflare R2 (optionnel) ---
# Si renseignées, les uploads de fichiers (CV, images) sont envoyés vers S3/R2 avec
# chiffrement côté serveur (SSE: AES256) et uniquement en HTTPS (endpoint obligatoirement en https://).
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="connecteo-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Optionnel : base de données dédiée aux tests d'intégration (vitest)
# TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/connecteo_test"

# --- Politique de rétention RGPD (purge des données expirées) ---
# Candidatures (candidatures + CV associés) : durée de conservation en mois.
APPLICATION_RETENTION_MONTHS="24"
# Messages du formulaire de contact : durée de conservation en mois.
CONTACT_MESSAGE_RETENTION_MONTHS="12"
# Vues pages anonymisées (analytics sans cookie) : durée en jours (13 mois).
PAGE_VIEW_RETENTION_DAYS="395"
