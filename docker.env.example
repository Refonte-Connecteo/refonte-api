# Variables de docker-compose.yml. « make init » copie ce fichier en docker.env
# et remplit POSTGRES_PASSWORD avec une valeur aléatoire. Ne commitez jamais docker.env.
# Les secrets de l'API (JWT, chiffrement…) restent dans .env.

# Base PostgreSQL du conteneur « db » (différente de votre base locale connecteo_db1)
POSTGRES_DB=connecteo
POSTGRES_USER=postgres
# Lettres et chiffres uniquement : il est repris tel quel dans DATABASE_URL.
POSTGRES_PASSWORD=

# Ports publiés sur la machine
API_PORT=3000
FRONT_PORT=3001

# Accès depuis les autres PC du réseau local (désactivé par défaut) :
#   BIND_ADDRESS=0.0.0.0        écoute sur toutes les interfaces, pas seulement 127.0.0.1
#   PUBLIC_HOST=192.168.1.20    adresse IP de ce PC, utilisée par les navigateurs pour joindre l'API
# Après modification : make up (le site est reconstruit, l'adresse de l'API y est figée).
BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
