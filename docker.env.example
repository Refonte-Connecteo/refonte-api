# Variables de docker-compose.yml. « make init » copie ce fichier en docker.env
# et remplit POSTGRES_PASSWORD avec une valeur aléatoire. Ne commitez jamais docker.env.
# Les secrets de l'API (JWT, chiffrement…) restent dans .env.

# Base PostgreSQL du conteneur « db » (différente de votre base locale connecteo_db1)
POSTGRES_DB=connecteo
POSTGRES_USER=postgres
# Lettres et chiffres uniquement : il est repris tel quel dans DATABASE_URL.
POSTGRES_PASSWORD=

# Ports publiés sur la machine (127.0.0.1 uniquement)
API_PORT=3000
FRONT_PORT=3001
